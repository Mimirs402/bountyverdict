{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bountyverdict-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "X402_NETWORK": "eip155:84532",
    "X402_FACILITATOR_URL": "https://x402.org/facilitator"
  },
  "ratelimits": [
    {
      "name": "CANARY_RATE_LIMITER",
      "namespace_id": "402701",
      "simple": { "limit": 1, "period": 60 }
    },
    {
      "name": "FLAKE_RATE_LIMITER",
      "namespace_id": "402703",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "NEAR_MARKET_RATE_LIMITER",
      "namespace_id": "402705",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "env": {
    "production": {
      "name": "bountyverdict-agent-production",
      "vars": {
        "X402_NETWORK": "eip155:8453",
        "X402_FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
        "THE402_AUTOMATION_ENABLED": "YES",
        "THE402_PLATFORM_ENVELOPE_AUTH_ENABLED": "YES",
        "NEAR_MARKET_AUTOMATION_ENABLED": "YES",
        "THE402_SERVICE_MAP": "{\"svc_4462e481fedf4afc\":\"single\",\"svc_6df309e4408e4de7\":\"portfolio\",\"svc_ca98b66ee3d24836\":\"harness\",\"svc_75dc3d5021bb4a22\":\"skill\",\"svc_f269590f47ae463f\":\"run\",\"svc_3cfea7eb5f574e6e\":\"flake\",\"svc_6bd98fed2d9a43d1\":\"mcpdrift\"}"
      },
      "ratelimits": [
        {
          "name": "CANARY_RATE_LIMITER",
          "namespace_id": "402702",
          "simple": { "limit": 1, "period": 60 }
        },
        {
          "name": "FLAKE_RATE_LIMITER",
          "namespace_id": "402704",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "NEAR_MARKET_RATE_LIMITER",
          "namespace_id": "402706",
          "simple": { "limit": 30, "period": 60 }
        }
      ]
    }
  }
}
