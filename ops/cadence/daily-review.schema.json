{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_date",
    "actionable",
    "priority",
    "bottleneck",
    "evidence",
    "recommended_change",
    "bounded_scope",
    "expected_metric",
    "do_not_do"
  ],
  "properties": {
    "review_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "actionable": {
      "type": "boolean"
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "none"]
    },
    "bottleneck": {
      "type": "string",
      "maxLength": 500
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "recommended_change": {
      "type": "string",
      "maxLength": 1000
    },
    "bounded_scope": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "expected_metric": {
      "type": "string",
      "maxLength": 500
    },
    "do_not_do": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
