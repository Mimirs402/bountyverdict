[Unit]
Description=Evaluate a fresh bounty opportunity and prepare a local solution
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.local/state/bountyverdict/opportunity-trigger.json

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/sandbox/bountyverdict/agent
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env node --experimental-strip-types scripts/opportunity-agent-workflow.ts
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
Nice=10
TimeoutStartSec=95min
