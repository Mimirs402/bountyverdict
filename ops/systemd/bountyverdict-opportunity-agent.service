[Unit]
Description=Evaluate a fresh bounty opportunity and prepare a local solution
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.local/state/bountyverdict/opportunity-trigger.json

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/sandbox/bountyverdict/agent
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env node --experimental-strip-types scripts/opportunity-agent-workflow.ts
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
StateDirectory=bountyverdict
StateDirectoryMode=0700
BindReadOnlyPaths=%h/Projects/sandbox/bountyverdict:%h/Projects/sandbox/bountyverdict %h/.codex/auth.json:%h/.codex/auth.json
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
Nice=10
TimeoutStartSec=95min
