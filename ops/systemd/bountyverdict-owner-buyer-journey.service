[Unit]
Description=Run one audited BountyVerdict natural search-to-purchase journey after N=25
After=network-online.target bountyverdict-funnel-tail.service bountyverdict-distribution-monitor.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/sandbox/bountyverdict/agent
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
Environment=AUDITED_MONITOR=owner-journey
Environment=EXECUTE_OWNER_BUYER_JOURNEY=YES
ExecStart=/usr/bin/env node --experimental-strip-types scripts/run-audited-monitor.ts
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=default.target
