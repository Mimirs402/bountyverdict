[Unit]
Description=BountyVerdict read-only Payan demand observer
After=network-online.target
Wants=network-online.target
Conflicts=bountyverdict-payan-demand.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/sandbox/bountyverdict-production-runtime/agent
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
Environment=PAYAN_BID=NO
Environment=PAYAN_FULFILL=NO
EnvironmentFile=%h/.config/bountyverdict/payan.env
ExecStart=/usr/bin/env node --experimental-strip-types scripts/payan-demand.ts
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/bountyverdict
UMask=0077
TimeoutStartSec=2min

[Install]
WantedBy=default.target
